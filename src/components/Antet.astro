---
import { cale } from '../lib/cale';
import { FIRMA, NAVIGATIE } from '../lib/firma';

const drumCurent = Astro.url.pathname;
// Comparația se face pe calea finală, cu tot cu base: pe previzualizarea din
// subfolder, `pathname` e „/vatra-nord-demo/parcelari”, iar un `startsWith`
// pe „/parcelari” n-ar mai potrivi niciodată.
const activ = (href: string) => {
  const tinta = cale(href);
  return tinta === cale('/') ? drumCurent === tinta : drumCurent.startsWith(tinta);
};
---

<header
  class="antet-bara fixed inset-x-0 top-0 z-40 flex items-center justify-between gap-4 px-4 sm:px-6"
  style="height: var(--header-h)"
>
  <a href={cale("/")} class="flex items-center gap-2.5" aria-label={`${FIRMA.nume}, pagina principală`}>
    {/*
      Marca: o tarla trasă în plan, împărțită în trei loturi, cu unul luat și
      drumul pe sub ea. E limbajul planului de amplasament, nu o casă sau un
      acoperiș: firma vinde teren, nu construcții.
    */}
    <svg width="32" height="24" viewBox="0 0 32 24" fill="none" aria-hidden="true">
      <path
        d="M2 6.5 30 4.5v12L2 18.5v-12Z"
        fill="none"
        stroke="var(--color-antet-text)"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path d="M11.33 5.83v12M20.67 5.17v12" stroke="var(--color-antet-text)" stroke-width="1.1" opacity="0.7" />
      <path d="M11.33 5.83 20.67 5.17v12l-9.34.66v-12Z" fill="var(--color-antet-text)" opacity="0.4" />
      <path d="M0.8 22 31.2 19.8" stroke="var(--color-antet-sters)" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span class="flex flex-col leading-none">
      <span class="antet__nume font-serif text-[1.15rem] tracking-tight">{FIRMA.nume}</span>
      <span class="antet__tagline hidden text-[0.625rem] sm:block">loturi de casă · Ilfov nord</span>
    </span>
  </a>

  <nav class="hidden items-center gap-1 md:flex" aria-label="Navigare principală">
    {
      NAVIGATIE.map((n) => (
        <a
          href={cale(n.href)}
          class:list={[
            'antet__legatura rounded-[4px] px-3 py-2 text-[0.9375rem] transition-colors duration-150',
          ]}
          aria-current={activ(n.href) ? 'page' : undefined}
        >
          {n.text}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-2">
    <a href={FIRMA.telefonLink} class="buton buton-antet whitespace-nowrap">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M5.2 2.5 6.6 5.3 5.3 6.6c.6 1.3 1.8 2.5 3.1 3.1l1.3-1.3 2.8 1.4v2.4c0 .6-.5 1-1.1.9C6.6 12.5 3.5 9.4 2.9 4.6c-.1-.6.3-1.1.9-1.1h1.4Z"
          fill="currentColor"
        />
      </svg>
      <span class="hidden sm:inline">{FIRMA.telefon}</span>
      <span class="sm:hidden">Sună</span>
    </a>

    {/* Sigla WhatsApp, desenată din calea oficială. În nișa asta jumătate din
        cereri vin pe WhatsApp, iar butonul se recunoaște după semn, nu după
        cuvânt: pe telefon rămâne doar semnul. */}
    <a
      href={FIRMA.whatsapp}
      target="_blank"
      rel="noopener"
      class="buton buton-whatsapp whitespace-nowrap"
      aria-label={`Scrie-ne pe WhatsApp la ${FIRMA.telefon}`}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" />
      </svg>
      <span class="hidden sm:inline">WhatsApp</span>
    </a>

    <button
      type="button"
      id="comuta-meniu"
      class="buton buton-antet-gol px-2.5 md:hidden"
      aria-label="Deschide meniul"
      aria-expanded="false"
      aria-controls="meniu-mobil"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>
</header>

<div
  id="meniu-mobil"
  hidden
  class="meniu-mobil fixed inset-x-0 z-30 px-4 py-3 shadow-panou md:hidden"
  style="top: var(--header-h)"
>
  <nav class="flex flex-col" aria-label="Navigare mobilă">
    {
      NAVIGATIE.map((n) => (
        <a
          href={cale(n.href)}
          class="py-3 text-[1.0625rem] last:border-0"
          aria-current={activ(n.href) ? 'page' : undefined}
        >
          {n.text}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const buton = document.getElementById('comuta-meniu');
  const meniu = document.getElementById('meniu-mobil');
  buton?.addEventListener('click', () => {
    const deschis = buton.getAttribute('aria-expanded') === 'true';
    buton.setAttribute('aria-expanded', String(!deschis));
    buton.setAttribute('aria-label', deschis ? 'Deschide meniul' : 'Închide meniul');
    if (meniu) meniu.hidden = deschis;
  });
</script>
