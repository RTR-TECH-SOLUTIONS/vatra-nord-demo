---
import { cale } from '../lib/cale';
import { FIRMA, NAVIGATIE } from '../lib/firma';

const drumCurent = Astro.url.pathname;
// Comparația se face pe calea finală, cu tot cu base: pe previzualizarea din
// subfolder, `pathname` e „/vatra-nord-demo/parcelari”, iar un `startsWith`
// pe „/parcelari” n-ar mai potrivi niciodată.
const activ = (href: string) => {
  const tinta = cale(href);
  return tinta === cale('/') ? drumCurent === tinta : drumCurent.startsWith(tinta);
};
---

<header
  class="fixed inset-x-0 top-0 z-40 flex items-center justify-between gap-4 border-b border-hairline bg-paper-3 px-4 sm:px-6"
  style="height: var(--header-h)"
>
  <a href={cale("/")} class="flex items-center gap-2.5" aria-label={`${FIRMA.nume}, pagina principală`}>
    {/* Marca: o parcelare văzută oblic, trei loturi și drumul dintre ele. */}
    <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
      <path d="M2 17.5 9.5 5h4.2L6.2 17.5H2Z" fill="var(--color-accent)" />
      <path d="M7.4 17.5 14.9 5h4.2l-7.5 12.5H7.4Z" fill="var(--color-accent)" opacity="0.62" />
      <path d="M12.8 17.5 20.3 5h4.2L17 17.5h-4.2Z" fill="var(--color-accent)" opacity="0.34" />
      <path d="M1 21h24" stroke="var(--color-ink)" stroke-width="1.4" />
    </svg>
    <span class="flex flex-col leading-none">
      <span class="font-serif text-[1.15rem] tracking-tight">{FIRMA.nume}</span>
      <span class="eticheta hidden text-[0.625rem] sm:block">loturi de casă · Ilfov nord</span>
    </span>
  </a>

  <nav class="hidden items-center gap-1 md:flex" aria-label="Navigare principală">
    {
      NAVIGATIE.map((n) => (
        <a
          href={cale(n.href)}
          class:list={[
            'rounded-[4px] px-3 py-2 text-[0.9375rem] transition-colors duration-150',
            activ(n.href) ? 'text-ink' : 'text-ink-2 hover:text-ink',
          ]}
          aria-current={activ(n.href) ? 'page' : undefined}
        >
          {n.text}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-2">
    <a href={FIRMA.telefonLink} class="buton buton-primar whitespace-nowrap">
      <span class="hidden sm:inline">{FIRMA.telefon}</span>
      <span class="sm:hidden">Sună</span>
    </a>
    <button
      type="button"
      id="comuta-meniu"
      class="buton buton-secundar px-2.5 md:hidden"
      aria-label="Deschide meniul"
      aria-expanded="false"
      aria-controls="meniu-mobil"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>
</header>

<div
  id="meniu-mobil"
  hidden
  class="fixed inset-x-0 z-30 border-b border-hairline bg-paper-3 px-4 py-3 shadow-panou md:hidden"
  style="top: var(--header-h)"
>
  <nav class="flex flex-col" aria-label="Navigare mobilă">
    {
      NAVIGATIE.map((n) => (
        <a
          href={cale(n.href)}
          class="border-b border-hairline py-3 text-[1.0625rem] last:border-0"
          aria-current={activ(n.href) ? 'page' : undefined}
        >
          {n.text}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const buton = document.getElementById('comuta-meniu');
  const meniu = document.getElementById('meniu-mobil');
  buton?.addEventListener('click', () => {
    const deschis = buton.getAttribute('aria-expanded') === 'true';
    buton.setAttribute('aria-expanded', String(!deschis));
    buton.setAttribute('aria-label', deschis ? 'Deschide meniul' : 'Închide meniul');
    if (meniu) meniu.hidden = deschis;
  });
</script>
