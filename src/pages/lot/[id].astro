---
import { cale } from '../../lib/cale';
import Baza from '../../layouts/Baza.astro';
import proiecteJson from '../../data/proiecte.json';
import loturiJson from '../../data/loturi.json';
import poiJson from '../../data/poi.json';
import { STATUSURI, euro, mp, ml, dataRo, cuTva, azimutSpreLot } from '../../lib/loturi';
import type { Proiect, ProprietatiLot } from '../../lib/loturi';
import { cadruImagine, laPixeli, LATIME_IMAGINE, INALTIME_IMAGINE } from '../../lib/imagine.js';
import { edificabilLot, potentialConstruire, silueta, orientare, RETRAGERI } from '../../lib/parcelare.js';
import { planLot } from '../../lib/plan';
import { km, minute, kmRo } from '../../lib/distante';
import { FIRMA } from '../../lib/firma';
import AplicaPublicat from '../../components/AplicaPublicat.astro';

interface Lot {
  properties: ProprietatiLot;
  geometry: { coordinates: [number, number][][] };
}

export function getStaticPaths() {
  const proiecte = proiecteJson as unknown as Proiect[];
  const loturi = (loturiJson as unknown as { features: Lot[] }).features;
  const dupaSlug = new Map(proiecte.map((p) => [p.slug, p]));

  return loturi.map((f) => {
    const p = dupaSlug.get(f.properties.proiect)!;
    const fratii = loturi.filter((x) => x.properties.proiect === p.slug);
    const idx = fratii.findIndex((x) => x.properties.id === f.properties.id);
    return {
      params: { id: f.properties.id },
      props: {
        lot: f,
        proiect: p,
        fratii: fratii.map((x) => ({ inel: x.geometry.coordinates[0], p: x.properties })),
        vecini: [fratii[idx - 1], fratii[idx + 1], fratii[idx + 2]]
          .filter(Boolean)
          .map((x) => x.properties),
      },
    };
  });
}

interface Props {
  lot: Lot;
  proiect: Proiect;
  fratii: { inel: [number, number][]; p: ProprietatiLot }[];
  vecini: ProprietatiLot[];
}

const { lot, proiect, fratii, vecini } = Astro.props;
const p = lot.properties;
const cfg = STATUSURI[p.status];

// Ce se poate construi pe lotul ăsta, calculat din retrageri și din POT/CUT.
const spreLot = azimutSpreLot(proiect, p.sir);
const edificabil = edificabilLot(lot.geometry.coordinates[0], spreLot);
const construire = potentialConstruire(p.suprafata, proiect.urbanism, edificabil?.suprafata ?? null);
const casa = silueta(edificabil, construire.amprenta);
const busola = orientare(spreLot);

/*
  Planul de amplasament, desenat vectorial din conturul real al lotului.
  Înainte aici era un decupaj din imaginea satelitară, mărit de patru ori: peste
  câmpul din Ilfov, sursa nu are atâția pixeli pe metru, deci ieșea o pată verde
  neclară exact în locul în care pagina trebuia să arate marfa. Desenul spune mai
  mult și rămâne clar la orice mărime.
*/
const desen = planLot({
  inel: lot.geometry.coordinates[0],
  azimutStrada: (spreLot + 180) % 360,
  edificabil: edificabil?.inel ?? null,
  casa: casa?.inel ?? null,
  vecini: fratii
    .filter((x) => x.p.id !== p.id)
    .map((x) => ({
      inel: x.inel,
      culoare: STATUSURI[x.p.status].culoare,
      contur: STATUSURI[x.p.status].contur,
    })),
  latime: 720,
  culoare: cfg.culoare,
  contur: cfg.contur,
  deschidere: `${ml(p.front)} la stradă`,
  adancime: edificabil ? `adâncime ${String(Math.round((p.suprafata / p.front) * 10) / 10).replace('.', ',')} m` : null,
  strada: proiect.utilitati.find((u) => u.tip === 'Drum')?.detaliu?.split(',')[0] ?? 'drum de acces',
});

// Vederea aeriană: cadrul parcelării, cu lotul decupat din umbră. E singura
// imagine reală de pe pagină, deci răspunde la o singură întrebare — unde e.
const cadru = cadruImagine(proiect.bbox);
const puncte = lot.geometry.coordinates[0].map((c) => laPixeli(cadru, c).join(',')).join(' ');
const centruLot = lot.geometry.coordinates[0]
  .slice(0, -1)
  .reduce((a, c, _i, arr) => [a[0] + c[0] / arr.length, a[1] + c[1] / arr.length], [0, 0]) as [number, number];
const lupa = laPixeli(cadru, centruLot);

const poi = (poiJson as unknown as {
  features: { geometry: { coordinates: [number, number] }; properties: { nume: string } }[];
}).features
  .map((f) => ({ nume: f.properties.nume, distanta: km(centruLot, f.geometry.coordinates) }))
  .sort((a, b) => a.distanta - b.distanta)
  .slice(0, 5);

const rata = proiect.finantare
  ? Math.round((p.pret_total * (1 - proiect.finantare.avans / 100)) / proiect.finantare.luni)
  : null;

// Cifrele care decid, scoase din tabel și puse în cap: astea sunt întrebate la
// telefon, în ordinea asta.
const cifre: [string, string][] = [
  [mp(p.suprafata), 'suprafață'],
  [ml(p.front), 'deschidere la stradă'],
  [`${construire.amprenta} m²`, 'amprentă maximă la sol'],
  [proiect.urbanism.regim, 'regim de înălțime'],
];

const specificatii: [string, string][] = [
  ['Formă', p.laturi > 4 ? `poligon cu ${p.laturi} laturi, urmează hotarul` : 'patrulater'],
  ['Preț pe m²', `${euro(p.pret_mp)}/m²`],
  ['Regim', 'Intravilan'],
  ['POT maxim', `${proiect.urbanism.pot}%`],
  ['CUT maxim', String(proiect.urbanism.cut).replace('.', ',')],
  ['Urbanism', proiect.urbanism.instrument],
  ['Cadastru', 'Individual, intabulat, fără sarcini'],
  ['Orientare', `deschidere la ${busola.strada}, curtea în spate la ${busola.curte}`],
];
---

<Baza
  titlu={`Lotul ${p.cod}, ${proiect.nume} · ${FIRMA.nume}`}
  descriere={`Lot de ${p.suprafata} m² la ${proiect.nume}, ${proiect.localitate}. ${euro(p.pret_total)} plus TVA, ${euro(p.pret_mp)} pe m². ${cfg.eticheta}.`}
>
  <AplicaPublicat />
  <article class="lot" data-lot={p.id} data-suprafata={p.suprafata}>
    <nav class="firimituri" aria-label="Navigare secundară">
      <a href={cale("/parcelari")}>Parcelări</a>
      <span aria-hidden="true">·</span>
      <a href={cale(`/parcelari/${proiect.slug}`)}>{proiect.nume}</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page">Lotul {p.cod}</span>
    </nav>

    <header class="cap">
      <div class="cap__text">
        <p class="cap__loc">{proiect.nume} · {proiect.localitate}, județul {proiect.judet}</p>
        <h1>Lotul {p.cod}</h1>
        <p class="stare" style={`--c: ${cfg.culoare}`} data-camp="status">{cfg.eticheta}</p>
        <p id="semn-publicat" class="semn-publicat" hidden></p>

        <p class="pret cifre">
          <span data-camp="pret_total">{euro(p.pret_total)}</span><span class="pret__tva"> + TVA</span>
        </p>
        <p class="pret__mp cifre">
          {euro(cuTva(p.pret_total))} cu TVA · <span data-camp="pret_mp">{euro(p.pret_mp)}/m²</span>
        </p>
        {
          rata && (
            <p class="pret__rata cifre">
              sau avans {proiect.finantare!.avans}% și {proiect.finantare!.luni} de rate a {euro(rata)}
            </p>
          )
        }

        {p.observatii && <p class="nota-lot">{p.observatii}</p>}

        <div class="cap__actiuni">
          <a class="buton buton-primar" href={FIRMA.telefonLink}>Sună pentru lotul {p.cod}</a>
          <a class="buton buton-secundar" href={cale(`/?parcelare=${proiect.slug}&lot=${p.id}`)}>
            Vezi pe hartă
          </a>
        </div>
      </div>

      <figure class="plan-mare">
        <div class="plan-mare__cadru" set:html={desen} />
        <figcaption>
          Planul lotului {p.cod} în parcelarea {proiect.nume}: conturul măsurat, linia punctată a
          retragerilor obligatorii și silueta casei maxime care încape între ele. Loturile din jur
          sunt desenate stins.
        </figcaption>
      </figure>
    </header>

    <ul class="cifre-cap">
      {
        cifre.map(([valoare, eticheta]) => (
          <li>
            <b class="cifre">{valoare}</b>
            <span>{eticheta}</span>
          </li>
        ))
      }
    </ul>

    <div class="continut">
      <section class="sectiune">
        <h2>Ce poți construi aici</h2>
        <p class="proza deschidere">
          {casa
            ? `Pe lotul ăsta încape o casă de până la ${String(casa.latime).replace('.', ',')} pe ${String(casa.adancime).replace('.', ',')} metri, adică ${construire.amprenta} m² la sol.`
            : `Lotul e prea îngust pentru retragerile obligatorii de la ${proiect.nume}.`}
          {construire.leaga === 'POT'
            ? ' Limita o dă procentul de ocupare, nu forma lotului.'
            : ' Limita o dau retragerile, nu procentul de ocupare: lotul e îngust.'}
        </p>
        <div class="fisa">
          <div>
            <dt class="fisa__cheie">Amprentă maximă la sol</dt>
            <dd class="fisa__valoare cifre">
              {construire.amprenta} m²
              <span class="nota">
                · din POT {proiect.urbanism.pot}% ar ieși {construire.dinPot} m², între retrageri
                încap {edificabil ? edificabil.suprafata : 0} m²
              </span>
            </dd>
          </div>
          <div>
            <dt class="fisa__cheie">Suprafață desfășurată maximă</dt>
            <dd class="fisa__valoare cifre">
              {construire.desfasurata} m²
              <span class="nota">· din CUT {String(proiect.urbanism.cut).replace('.', ',')}</span>
            </dd>
          </div>
          {
            edificabil && (
              <div>
                <dt class="fisa__cheie">Cutia construibilă</dt>
                <dd class="fisa__valoare cifre">
                  {String(edificabil.latime).replace('.', ',')} × {String(edificabil.adancime).replace('.', ',')} m
                  <span class="nota">
                    · deschidere {ml(p.front)} minus {RETRAGERI.lateral} m de fiecare parte
                  </span>
                </dd>
              </div>
            )
          }
          <div>
            <dt class="fisa__cheie">Retrageri obligatorii</dt>
            <dd class="fisa__valoare cifre">
              {RETRAGERI.fata} m față, {RETRAGERI.lateral} m lateral, {RETRAGERI.spate} m spate
            </dd>
          </div>
        </div>
        <p class="nota">
          Calcul orientativ, pe retragerile uzuale pentru locuințe individuale în Ilfov. Valorile
          exacte se iau din certificatul de urbanism eliberat de primărie pentru lotul tău.
          {busola.comentariu && ` ${busola.comentariu.charAt(0).toUpperCase()}${busola.comentariu.slice(1)}.`}
        </p>
      </section>

      <section class="sectiune">
        <h2>Unde e lotul</h2>
        <figure class="aeriana">
          <div class="aeriana__cadru">
            <img
              src={cale(`/imagini/${proiect.slug}.jpg`)}
              alt={`Vedere aeriană a parcelării ${proiect.nume}, cu lotul ${p.cod} evidențiat`}
              width={LATIME_IMAGINE}
              height={INALTIME_IMAGINE}
              loading="lazy"
            />
            <svg
              class="aeriana__contur"
              viewBox={`0 0 ${LATIME_IMAGINE} ${INALTIME_IMAGINE}`}
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <defs>
                <mask id="gaura">
                  <rect width={LATIME_IMAGINE} height={INALTIME_IMAGINE} fill="white" />
                  <polygon points={puncte} fill="black" />
                </mask>
              </defs>
              <rect width={LATIME_IMAGINE} height={INALTIME_IMAGINE} fill="rgba(10,14,16,0.34)" mask="url(#gaura)" />
              <polygon points={puncte} fill="none" stroke="#ffffff" stroke-width="3" />
              <circle cx={lupa[0]} cy={lupa[1]} r="150" fill="none" stroke="rgba(255,255,255,0.55)" stroke-width="2" />
            </svg>
          </div>
          <figcaption>
            Imagine satelitară Mapbox și Maxar. Lotul {p.cod}, în parcelarea {proiect.nume}.
          </figcaption>
        </figure>

        <div class="fisa fisa--apropiere">
          {
            poi.map((x) => (
              <div>
                <dt class="fisa__cheie">{x.nume}</dt>
                <dd class="fisa__valoare cifre">
                  {kmRo(x.distanta)} <span class="nota">· circa {minute(x.distanta)} min</span>
                </dd>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sectiune">
        <h2>Ce utilități ajung la lot</h2>
        <div class="fisa">
          {
            proiect.utilitati.map((u) => (
              <div>
                <dt class="fisa__cheie">
                  {u.tip}
                  <span class="badge-stare" data-stare={u.stare}>{u.stare}</span>
                </dt>
                <dd class="fisa__valoare">{u.detaliu ?? '—'}</dd>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sectiune">
        <h2>Specificații</h2>
        <div class="fisa">
          {
            specificatii.map(([cheie, valoare]) => (
              <div>
                <dt class="fisa__cheie">{cheie}</dt>
                <dd class="fisa__valoare cifre">{valoare}</dd>
              </div>
            ))
          }
        </div>
        <p class="nota">
          Prețul afișat nu conține TVA. Disponibilitate actualizată {dataRo(p.actualizat)}. Limitele
          desenate au caracter informativ și nu înlocuiesc măsurătoarea cadastrală.
        </p>
      </section>

      {
        proiect.finantare && rata && (
          <section class="sectiune">
            <h2>Cât ar fi rata</h2>
            <div class="fisa">
              <div>
                <dt class="fisa__cheie">Avans, {proiect.finantare.avans}%</dt>
                <dd class="fisa__valoare cifre">
                  {euro(Math.round((p.pret_total * proiect.finantare.avans) / 100))}
                </dd>
              </div>
              <div>
                <dt class="fisa__cheie">{proiect.finantare.luni} de rate lunare</dt>
                <dd class="fisa__valoare cifre">{euro(rata)} pe lună</dd>
              </div>
              <div>
                <dt class="fisa__cheie">Dobândă</dt>
                <dd class="fisa__valoare cifre">{proiect.finantare.dobanda}%</dd>
              </div>
            </div>
            <p class="nota">
              Calcul orientativ, fără TVA și fără taxele notariale.{' '}
              <a href={cale("/finantare")}>Cum funcționează plata în rate</a>
            </p>
          </section>
        )
      }

      {
        vecini.length > 0 && (
          <section class="sectiune">
            <h2>Loturi alăturate</h2>
            <ul class="vecini">
              {vecini.map((v) => (
                <li>
                  <a href={cale(`/lot/${v.id}`)}>
                    <span class="vecini__cod">Lotul {v.cod}</span>
                    <span class="vecini__date cifre">
                      {mp(v.suprafata)} · {euro(v.pret_total)}
                    </span>
                    <span class="vecini__stare" style={`--c: ${STATUSURI[v.status].culoare}`}>
                      {STATUSURI[v.status].eticheta}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="nota">
              <a href={cale(`/parcelari/${proiect.slug}#loturi`)}>Vezi toate loturile din {proiect.nume}</a>
            </p>
          </section>
        )
      }

      <section class="sectiune final">
        <h2>Vino să vezi lotul</h2>
        <p class="proza">
          Vizionările se fac doar cu programare. Mergem pe teren și îți arătăm bornele lotului{' '}
          {p.cod}. Sună-l pe {FIRMA.persoana}, {FIRMA.rol}.
        </p>
        <div class="final__actiuni">
          <a class="buton buton-primar" href={FIRMA.telefonLink}>{FIRMA.telefon}</a>
          <a class="buton buton-secundar" href={cale(`/contact?parcelare=${proiect.slug}&lot=${p.id}`)}>
            Scrie-ne
          </a>
        </div>
      </section>
    </div>
  </article>
</Baza>

<style>
  .lot {
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 0;
  }

  @media (min-width: 48rem) {
    .lot {
      padding-inline: 2rem;
    }
  }

  .firimituri {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .firimituri a {
    color: var(--color-ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cap {
    margin-top: 1.5rem;
    display: grid;
    gap: 2rem;
  }

  /* Textul pe stânga, planul pe dreapta. Planul e lat, deci primește mai mult
     spațiu decât primea imaginea satelitară, care oricum era ilizibilă. */
  @media (min-width: 62rem) {
    .cap {
      grid-template-columns: 21rem 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .cap__loc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-2);
  }

  .cap h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    margin-top: 0.35rem;
  }

  .stare {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-mic);
    color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 34%, transparent);
  }

  .pret {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 1.875rem;
    line-height: 1.1;
  }

  .pret .pret__tva {
    font-size: 0.9375rem;
    color: var(--color-ink-3);
  }

  .semn-publicat {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  [data-sters='da'] .pret {
    text-decoration: line-through;
    color: var(--color-ink-3);
  }

  .pret__mp {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }

  .pret__rata {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  .nota-lot {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    border-left: 2px solid var(--color-hairline);
    padding-left: 0.75rem;
  }

  .cap__actiuni {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* ------------------------------------------------------ planul lotului */
  .plan-mare {
    margin: 0;
  }

  .plan-mare__cadru {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
    background: var(--color-paper);
    overflow: hidden;
    line-height: 0;
  }

  .plan-mare :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Sub 48rem desenul coboară pe la 350 de pixeli lățime, iar scrisul de pe el
     ajunge la cinci pixeli. Cotele se sting; cifrele lor sunt oricum în banda
     de sub desen. */
  @media (max-width: 47.99rem) {
    .plan-mare :global(.plan-lot__adnotari),
    .plan-mare :global(.plan-lot__adnotare) {
      display: none;
    }
  }

  .plan-mare figcaption,
  .aeriana figcaption {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-ink-3);
    max-width: 44rem;
  }

  /* ------------------------------------------------------- banda de cifre */
  /* Patru cifre mari, cele care se întreabă la telefon. Rup pagina între cap
     și tabele, ca să nu fie șase liste identice una sub alta. */
  .cifre-cap {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
    overflow: hidden;
  }

  @media (min-width: 48rem) {
    .cifre-cap {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .cifre-cap li {
    background: var(--color-paper-3);
    padding: 1rem 1.125rem 1.125rem;
  }

  .cifre-cap b {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cifre-cap span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  /* -------------------------------------------------------- vedere aeriană */
  .aeriana {
    margin: 0 0 1.75rem;
  }

  .aeriana__cadru {
    position: relative;
    border-radius: var(--radius-panou);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    aspect-ratio: 16 / 9;
    max-width: 52rem;
  }

  .aeriana__cadru img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .aeriana__contur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .continut {
    margin-top: 1rem;
  }

  .sectiune {
    padding-block: 2.75rem;
    border-top: 1px solid var(--color-hairline);
  }

