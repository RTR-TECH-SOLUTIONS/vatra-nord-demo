---
import { cale } from '../lib/cale';
import Baza from '../layouts/Baza.astro';
import proiecteJson from '../data/proiecte.json';
import loturiJson from '../data/loturi.json';
import { STATUSURI, ORDINE_STATUS, dataRo } from '../lib/loturi';
import pinuriJson from '../data/pinuri.json';
import { STARI_PIN, marcaDinNume, type Pin } from '../lib/pin';
import type { Proiect, ProprietatiLot } from '../lib/loturi';
import { areCheie, areMapbox } from '../lib/basemap';
import { benziBuget } from '../lib/buget';
// Marca Mapbox, fișierul oficial din mapbox-gl.css. E cerută de licență
// când le folosim dalele, deci nu e decor și nu se scoate.
const MARCA_MAPBOX = `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill-rule="evenodd" viewBox="0 0 88 23"><defs><path id="logo" d="M11.5 2.25c5.105 0 9.25 4.145 9.25 9.25s-4.145 9.25-9.25 9.25-9.25-4.145-9.25-9.25 4.145-9.25 9.25-9.25zM6.997 15.983c-.051-.338-.828-5.802 2.233-8.873a4.395 4.395 0 013.13-1.28c1.27 0 2.49.51 3.39 1.42.91.9 1.42 2.12 1.42 3.39 0 1.18-.449 2.301-1.28 3.13C12.72 16.93 7 16 7 16l-.003-.017zM15.3 10.5l-2 .8-.8 2-.8-2-2-.8 2-.8.8-2 .8 2 2 .8z"/><path id="text" d="M50.63 8c.13 0 .23.1.23.23V9c.7-.76 1.7-1.18 2.73-1.18 2.17 0 3.95 1.85 3.95 4.17s-1.77 4.19-3.94 4.19c-1.04 0-2.03-.43-2.74-1.18v3.77c0 .13-.1.23-.23.23h-1.4c-.13 0-.23-.1-.23-.23V8.23c0-.12.1-.23.23-.23h1.4zm-3.86.01c.01 0 .01 0 .01-.01.13 0 .22.1.22.22v7.55c0 .12-.1.23-.23.23h-1.4c-.13 0-.23-.1-.23-.23V15c-.7.76-1.69 1.19-2.73 1.19-2.17 0-3.94-1.87-3.94-4.19 0-2.32 1.77-4.19 3.94-4.19 1.03 0 2.02.43 2.73 1.18v-.75c0-.12.1-.23.23-.23h1.4zm26.375-.19a4.24 4.24 0 00-4.16 3.29c-.13.59-.13 1.19 0 1.77a4.233 4.233 0 004.17 3.3c2.35 0 4.26-1.87 4.26-4.19 0-2.32-1.9-4.17-4.27-4.17zM60.63 5c.13 0 .23.1.23.23v3.76c.7-.76 1.7-1.18 2.73-1.18 1.88 0 3.45 1.4 3.84 3.28.13.59.13 1.2 0 1.8-.39 1.88-1.96 3.29-3.84 3.29-1.03 0-2.02-.43-2.73-1.18v.77c0 .12-.1.23-.23.23h-1.4c-.13 0-.23-.1-.23-.23V5.23c0-.12.1-.23.23-.23h1.4zm-34 11h-1.4c-.13 0-.23-.11-.23-.23V8.22c.01-.13.1-.22.23-.22h1.4c.13 0 .22.11.23.22v.68c.5-.68 1.3-1.09 2.16-1.1h.03c1.09 0 2.09.6 2.6 1.55.45-.95 1.4-1.55 2.44-1.56 1.62 0 2.93 1.25 2.9 2.78l.03 5.2c0 .13-.1.23-.23.23h-1.41c-.13 0-.23-.11-.23-.23v-4.59c0-.98-.74-1.71-1.62-1.71-.8 0-1.46.7-1.59 1.62l.01 4.68c0 .13-.11.23-.23.23h-1.41c-.13 0-.23-.11-.23-.23v-4.59c0-.98-.74-1.71-1.62-1.71-.85 0-1.54.79-1.6 1.8v4.5c0 .13-.1.23-.23.23zm53.615 0h-1.61c-.04 0-.08-.01-.12-.03-.09-.06-.13-.19-.06-.28l2.43-3.71-2.39-3.65a.213.213 0 01-.03-.12c0-.12.09-.21.21-.21h1.61c.13 0 .24.06.3.17l1.41 2.37 1.4-2.37a.34.34 0 01.3-.17h1.6c.04 0 .08.01.12.03.09.06.13.19.06.28l-2.37 3.65 2.43 3.7c0 .05.01.09.01.13 0 .12-.09.21-.21.21h-1.61c-.13 0-.24-.06-.3-.17l-1.44-2.42-1.44 2.42a.34.34 0 01-.3.17zm-7.12-1.49c-1.33 0-2.42-1.12-2.42-2.51 0-1.39 1.08-2.52 2.42-2.52 1.33 0 2.42 1.12 2.42 2.51 0 1.39-1.08 2.51-2.42 2.52zm-19.865 0c-1.32 0-2.39-1.11-2.42-2.48v-.07c.02-1.38 1.09-2.49 2.4-2.49 1.32 0 2.41 1.12 2.41 2.51 0 1.39-1.07 2.52-2.39 2.53zm-8.11-2.48c-.01 1.37-1.09 2.47-2.41 2.47s-2.42-1.12-2.42-2.51c0-1.39 1.08-2.52 2.4-2.52 1.33 0 2.39 1.11 2.41 2.48l.02.08zm18.12 2.47c-1.32 0-2.39-1.11-2.41-2.48v-.06c.02-1.38 1.09-2.48 2.41-2.48s2.42 1.12 2.42 2.51c0 1.39-1.09 2.51-2.42 2.51z"/></defs><mask id="clip"><rect x="0" y="0" width="100%" height="100%" fill="white"/><use xlink:href="#logo"/><use xlink:href="#text"/></mask><g id="outline" opacity="0.3" stroke="#000" stroke-width="3"><circle mask="url(#clip)" cx="11.5" cy="11.5" r="9.25"/><use xlink:href="#text" mask="url(#clip)"/></g><g id="fill" opacity="0.9" fill="#fff"><use xlink:href="#logo"/><use xlink:href="#text"/></g></svg>`;
import { FIRMA } from '../lib/firma';

const proiecte = proiecteJson as unknown as Proiect[];
const proprietati = pinuriJson as unknown as Pin[];
const loturi = loturiJson as unknown as { features: { properties: ProprietatiLot }[] };

const total = loturi.features.length;
const disponibile = loturi.features.filter((f) => f.properties.status === 'disponibil').length;
const actualizat = proiecte[0].actualizat;
const pretMinim = Math.min(
  ...loturi.features.filter((f) => f.properties.status === 'disponibil').map((f) => f.properties.pret_total),
);
// Benzile de buget se randează și la build, ca panoul să nu apară gol până
// pornește harta. Scriptul le recalculează pe parcelarea aleasă.
const benzi = benziBuget(loturi.features.map((f) => f.properties.pret_total));
---

<Baza
  titlu={`${FIRMA.nume} · harta loturilor`}
  descriere={`${disponibile} loturi disponibile în ${proiecte.length} parcelări din nordul Bucureștiului. Preț, suprafață și disponibilitate pe hartă.`}
  ecranPlin
>
  <script type="application/json" id="date-proiecte" set:html={JSON.stringify(proiecte)} />

  <div class="ecran-harta" data-mapbox={areMapbox ? "da" : undefined}>
    <div id="harta" class="panza"></div>

    <p id="harta-incarcare" class="incarcare">Se încarcă harta parcelărilor…</p>
    <div id="tooltip-lot" class="tooltip" hidden></div>

    <!-- Sidebar pe desktop, sertar tras de jos pe mobil. -->
    <aside id="sertar" class="sertar">
      <button
        type="button"
        id="comuta-sertar"
        class="sertar__maner"
        aria-expanded="false"
        aria-controls="sertar-continut"
      >
        <span>Loturi și filtre</span>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 10l4-4 4 4" stroke="currentColor" stroke-width="1.6" fill="none" />
        </svg>
      </button>

      <div id="sertar-continut" class="sertar__continut">
        <div class="sertar__derulabil">
        <div class="sertar__antet">
          <!-- Închiderea panoului există doar pe desktop: pe telefon sertarul
               are deja mânerul lui. -->
          <button type="button" id="inchide-sertar" class="sertar__inchide" aria-label="Închide portofoliul">×</button>
          <h1>Loturi de vânzare</h1>
          <p class="sertar__cifre">
            <span class="sertar__nr cifre" id="nr-gasite">{total}</span>
            <span class="sertar__nr-eticheta" id="eticheta-gasite">loturi pe hartă</span>
          </p>
          <p class="sertar__sub">
            <span id="sub-disponibile">{disponibile} disponibile</span>
            <span class="sertar__sub-sep">·</span>
            <span id="sub-pret">de la {new Intl.NumberFormat('ro-RO').format(pretMinim)} € + TVA</span>
          </p>
        </div>


        <!-- Legenda și filtrul de status sunt același element: culoarea de pe hartă
             se bifează direct, nu se explică într-un colț separat. -->
        <fieldset class="camp">
          <legend>Stare lot</legend>
          <ul class="stari">
            {
              ORDINE_STATUS.map((s) => (
                <li>
                  <label for={`filtru-${s}`}>
                    <input type="checkbox" id={`filtru-${s}`} checked />
                    <span class="pastila" style={`--c: ${STATUSURI[s].culoare}; --b: ${STATUSURI[s].contur}`} />
                    <span class="stari__text">{STATUSURI[s].scurt}</span>
                    <span class="stari__nr cifre" id={`nr-${s}`}>0</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <!-- Bugetul stă înaintea listei de parcelări, pentru că întrebarea „cât
             am de dat” vine înaintea întrebării „unde”. -->
        <fieldset class="camp camp--buget">
          <legend>Buget</legend>
          <ul class="benzi" id="benzi-buget">
            <li>
              <label for="buget-toate">
                <input type="radio" name="buget" id="buget-toate" value="toate" checked />
                <span class="benzi__bulina" aria-hidden="true" />
                <span class="benzi__text">Toate</span>
                <span class="benzi__nr cifre" data-nr-buget="toate">{total}</span>
              </label>
            </li>
            {
              benzi.map((b) => (
                <li>
                  <label for={`buget-${b.id}`}>
                    <input
                      type="radio"
                      name="buget"
                      id={`buget-${b.id}`}
                      value={b.id}
                      data-min={String(b.min)}
                      data-max={b.max === Infinity ? '' : String(b.max)}
                    />
                    <span class="benzi__bulina" aria-hidden="true" />
                    <span class="benzi__text">{b.eticheta}</span>
                    <span class="benzi__nr cifre" data-nr-buget={b.id}>0</span>
                  </label>
                </li>
              ))
            }
          </ul>
          <p class="camp__nota">Prețurile sunt fără TVA.</p>
        </fieldset>

        <div class="camp camp--portofoliu">
          <div class="camp__cap">
            <span class="eticheta-portofoliu">Portofoliu</span>
            <span class="cifre camp__nr">{proiecte.length + proprietati.length}</span>
          </div>

          <ul class="portofoliu">
            <li>
              <button type="button" class="rand" data-portofoliu="toate" aria-pressed="true">
                <span class="rand__marca rand__marca--toate" aria-hidden="true" />
                <span class="rand__text">
                  <span class="rand__nume">Toate</span>
                  <span class="rand__sub">parcelări și terenuri</span>
                </span>
                <span class="rand__nr cifre">{proiecte.length + proprietati.length}</span>
              </button>
            </li>
            {
              proiecte.map((p) => (
                <li>
                  <button
                    type="button"
                    class="rand"
                    data-portofoliu={p.slug}
                    data-fel="parcelare"
                    aria-pressed="false"
                  >
                    <span
                      class="rand__marca"
                      style={`--c: ${p.statistici.disponibile > 0 ? STARI_PIN.disponibil.culoare : STARI_PIN.vandut.culoare}`}
                      aria-hidden="true"
                    >
                      {marcaDinNume(p.nume)}
                    </span>
                    <span class="rand__text">
                      <span class="rand__nume">{p.nume}</span>
                      <span class="rand__sub">{p.localitate} · parcelare</span>
                    </span>
                    <span class="rand__nr cifre">{p.statistici.disponibile}</span>
                  </button>
                </li>
              ))
            }
            {
              proprietati.map((t) => (
                <li>
                  <button
                    type="button"
                    class="rand"
                    data-portofoliu={t.id}
                    data-fel="teren"
                    aria-pressed="false"
                  >
                    <span class="rand__marca" style={`--c: ${STARI_PIN[t.stare].culoare}`} aria-hidden="true">
                      {t.marca}
                    </span>
                    <span class="rand__text">
                      <span class="rand__nume">{t.nume}</span>
                      <span class="rand__sub">{t.detaliu}</span>
                    </span>
                    <span class="rand__stare" style={`--c: ${STARI_PIN[t.stare].culoare}`}>
                      {STARI_PIN[t.stare].eticheta}
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="camp">
          <div class="camp__cap">
            <label id="eticheta-sup">Suprafață</label>
            <output class="cifre" id="sup-valoare" for="sup-min sup-max"></output>
          </div>
          <div class="interval" id="sup-bara">
            <input type="range" id="sup-min" aria-labelledby="eticheta-sup" aria-label="Suprafață minimă" />
            <input type="range" id="sup-max" aria-labelledby="eticheta-sup" aria-label="Suprafață maximă" />
          </div>
        </div>

        <div class="camp camp--linie">
          <label for="filtru-poi" class="comutator">
            <input type="checkbox" id="filtru-poi" />
            <span>Arată punctele de interes</span>
          </label>
        </div>

        </div>

        <div class="sertar__subsol">
          <p class="camp__nota">Disponibilitate actualizată {dataRo(actualizat)}.</p>
          <div class="sertar__actiuni">
            <button type="button" id="reseteaza" class="buton buton-secundar">Resetează filtrele</button>
            <a href={cale("/parcelari")} class="lista-alt">Lista completă</a>
          </div>
        </div>
      </div>
    </aside>

    <button type="button" id="deschide-sertar" class="pastila-portofoliu panou" hidden>
      <span class="pastila-portofoliu__punct" aria-hidden="true"></span>
      Portofoliu
    </button>

    <div class="comutator-basemap panou" role="group" aria-label="Fundal hartă">
      <button type="button" data-basemap="harta" aria-pressed="true">Hartă</button>
      <button type="button" data-basemap="teren" aria-pressed="false">Teren</button>
    </div>

    {
      /* Licența Mapbox cere marca lor pe hartă când le folosești dalele.
         Fișierul e cel oficial din mapbox-gl.css, nu unul desenat de noi. */
      areMapbox && (
        <a
          class="marca-mapbox"
          href="https://www.mapbox.com/"
          target="_blank"
          rel="noopener"
          aria-label="Mapbox"
          set:html={MARCA_MAPBOX}
        />
      )
    }

    <!-- Fișa parcelării, deschisă din pin sau din portofoliu. -->
    <aside id="card-parcelare" class="card-parcelare panou" hidden aria-labelledby="cp-nume">
      <p class="card-parcelare__bara">
        Parcelare
        <button type="button" id="cp-inchide" class="card-parcelare__inchide" aria-label="Închide">×</button>
      </p>
      <div class="card-parcelare__corp">
        <h2 id="cp-nume" class="card-parcelare__nume"></h2>
        <p id="cp-unde" class="card-parcelare__unde"></p>

        <p class="card-parcelare__cifre cifre">
          <strong id="cp-disponibile"></strong>
          <span id="cp-pret"></span>
        </p>

        <p id="cp-descriere" class="card-parcelare__descriere"></p>

        <!-- Toate loturile, nu doar cele mai ieftine: la cinci-șapte loturi,
             tabelul întreg încape și e chiar oferta. -->
        <div class="card-parcelare__tabel">
          <p class="card-parcelare__subtitlu">Loturile din parcelare</p>
          <ul id="cp-loturi" class="card-parcelare__loturi cifre"></ul>
        </div>

        <!-- Butoanele stau înaintea utilităților: cine s-a decis din tabel nu
             trebuie să treacă prin șase rânduri de rețele ca să dea telefon. -->
        <div class="card-parcelare__actiuni">
          <a id="cp-suna" class="buton buton-primar" href="#">Sună acum</a>
          <button type="button" id="cp-intra" class="buton buton-secundar">Vezi pe hartă</button>
          <a id="cp-pagina" class="buton buton-secundar card-parcelare__lat" href="#">Pagina parcelării</a>
        </div>

        <div class="card-parcelare__tabel">
          <p class="card-parcelare__subtitlu">Ce ajunge la lot</p>
          <ul id="cp-utilitati" class="card-parcelare__utilitati"></ul>
        </div>
      </div>
    </aside>

    <p id="nota-publicat" class="nota-publicat panou" hidden></p>

    <p class="nota-demo">
      <strong>Demonstrație.</strong> Parcelare, prețuri și disponibilitate fictive. Limitele afișate
      au caracter informativ și nu înlocuiesc măsurătoarea cadastrală.
      {!areCheie && <span class="nota-demo__tehnic">Fundal satelit provizoriu, de înlocuit înainte de publicare.</span>}
    </p>

    <!-- Apare doar în vederea de la nivelul solului -->
    <div id="bara-strada" class="bara-strada panou" hidden>
      <span class="bara-strada__titlu">Vedere de la stradă</span>
      <span class="bara-strada__lot cifre" id="bara-strada-lot"></span>
      <span class="bara-strada__casa" id="bara-strada-casa"></span>
      <span class="bara-strada__stare" id="bara-strada-stare"></span>
      <button type="button" id="iesi-strada" class="buton buton-secundar">Înapoi la parcelare</button>
    </div>

    <div id="card-lot" class="card-lot panou" hidden></div>
  </div>
</Baza>

<script>
  import '../scripts/harta.ts';
</script>

<style is:global>
  /* ------------------------------------------------------------ scena hărții */
  .ecran-harta {
    position: fixed;
    inset: var(--header-h) 0 0 0;
  }

  /* Vinieta: ține privirea în centrul cadrului și dă adâncime unei imagini
     altfel perfect plate. Foarte discretă, altfel devine efect de filtru. */
  .ecran-harta::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background: radial-gradient(125% 95% at 50% 42%, transparent 52%, rgb(21 24 26 / 0.16) 100%);
  }

  /* Grăuntele de hârtie, doar pe planșă. Zona e câmp arabil, unde
     OpenStreetMap nu are aproape nicio suprafață desenată; fără textură,
     fondul ar fi o coală goală și ar părea că harta nu s-a încărcat. */
  .ecran-harta[data-fundal='harta']::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    opacity: 0.45;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23g)' opacity='0.5'/></svg>");
  }

  @media (prefers-reduced-motion: reduce) {
    .ecran-harta::after,
    .ecran-harta[data-fundal='harta']::before {
      display: none;
    }
  }

  /* maplibre-gl.css pune `position: relative` pe container si e injectat dupa
     acest bloc, deci selectorul trebuie sa aiba specificitate de id. */
  #harta.panza {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .incarcare {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-size: 0.9375rem;
    z-index: 5;
  }

  .maplibregl-ctrl-attrib {
    font-size: 10px;
  }

  .maplibregl-ctrl-bottom-right {
    bottom: 8px;
    right: 4px;
  }

  /* Scara grafică. Stă în colțul din stânga jos, ca pe orice planșă, dar acolo
     e sidebar-ul, deci o împingem lângă el. */
  #harta .maplibregl-ctrl-bottom-left {
    left: calc(var(--sidebar-w) + 32px);
    bottom: 10px;
  }

  .ecran-harta[data-mapbox] #harta .maplibregl-ctrl-bottom-left {
    left: calc(var(--sidebar-w) + 132px);
  }

  /* Controalele: MapLibre le livrează ca pătrate gri cu colț de 4px, adică
     exact „hartă de programator”. Le aducem în limbajul panourilor. */
  #harta .maplibregl-ctrl-group {
    background: rgb(251 250 247 / 0.92);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panou);
    box-shadow: var(--shadow-panou);
    overflow: hidden;
  }

  #harta .maplibregl-ctrl-group button {
    width: 32px;
    height: 32px;
  }

  #harta .maplibregl-ctrl-group button + button {
    border-top: 1px solid var(--color-hairline);
  }

  #harta .maplibregl-ctrl-group button:hover {
    background: var(--color-paper-2);
  }

  #harta .maplibregl-ctrl-group button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
    box-shadow: none;
  }

  #harta .maplibregl-ctrl-icon {
    opacity: 0.72;
  }

  #harta .maplibregl-ctrl-group button:hover .maplibregl-ctrl-icon {
    opacity: 1;
  }

  #harta .maplibregl-ctrl-attrib {
    background: rgb(251 250 247 / 0.82);
    border-radius: var(--radius-mic) 0 0 0;
  }

  /* Marca stă pe același rând cu scara, nu peste ea: licența cere să fie
     vizibilă, nu doar prezentă în pagină. */
  .marca-mapbox {
    position: absolute;
    left: calc(var(--sidebar-w) + 32px);
    bottom: 11px;
    z-index: 9;
    display: block;
    width: 88px;
    height: 23px;
    line-height: 0;
  }

  @media (max-width: 767px) {
    .marca-mapbox {
      left: 10px;
      bottom: 123px;
    }
  }

  /* --------------------------------------------------- fișa parcelării */
  /* Fișa începe sub comutatorul de fundal și se oprește deasupra controalelor
     de zoom: altfel le acoperă exact pe amândouă, iar omul rămâne fără cum să
     schimbe fundalul cât are fișa deschisă. */
  .card-parcelare {
    position: absolute;
    top: 57px;
    right: 16px;
    z-index: 11;
    width: 21.5rem;
    max-height: calc(100% - 57px - 108px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-panou);
  }

  /* Banda de sus, în verdele casei. Aceeași gramatică cu fișa lotului, care
     poartă culoarea stării: atingi ceva pe hartă, se deschide un panou cu
     bandă colorată în capul lui. */
  .card-parcelare__bara {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 6px 14px;
    background: var(--color-antet);
    color: var(--color-antet-text);
    border-radius: var(--radius-panou) var(--radius-panou) 0 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-parcelare__corp {
    padding: 13px 16px 16px;
  }

  .card-parcelare__inchide {
    font-size: 1.125rem;
    line-height: 1;
    color: inherit;
    opacity: 0.75;
    padding: 2px 6px;
  }

  .card-parcelare__inchide:hover {
    opacity: 1;
  }

  .card-parcelare__nume {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1.15;
  }

  .card-parcelare__unde {
    margin-top: 2px;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  .card-parcelare__cifre {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  .card-parcelare__cifre strong {
    font-weight: 500;
    color: var(--color-ink);
  }

  .card-parcelare__descriere {
    margin-top: 10px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  /* Utilitățile spun și ce NU e gata, cu detaliul lângă. Concurentul pune
     patru bife și atât, ceea ce e exact formularea pe care piața a învățat
     să nu o creadă. */
  .card-parcelare__utilitati {
    display: grid;
    gap: 5px;
  }

  .card-parcelare__utilitati li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .card-parcelare__utilitati b {
    flex: none;
    width: 5.5rem;
    font-weight: 400;
    color: var(--color-ink);
  }

  .card-parcelare__utilitati span {
    color: var(--color-ink-3);
  }

  .card-parcelare__utilitati [data-gata='da'] b::before {
    content: '✓ ';
    color: var(--color-disponibil);
  }

  .card-parcelare__utilitati [data-gata='nu'] b::before {
    content: '· ';
    color: var(--color-ink-3);
  }

  .card-parcelare__tabel {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--color-hairline);
  }

  .card-parcelare__subtitlu {
    font-size: 0.75rem;
    color: var(--color-ink-3);
    margin-bottom: 6px;
  }

  /* Tabelul loturilor: bulina de stare, codul, suprafața, prețul. Cu cinci-
     șapte loturi încape tot, deci nu mai e „o selecție”, e oferta. */
  .card-parcelare__loturi {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .card-parcelare__loturi button {
    display: grid;
    grid-template-columns: 10px 1fr auto auto;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 5px 4px;
    margin-inline: -4px;
    border-radius: var(--radius-mic);
    text-align: left;
  }

  .card-parcelare__loturi button:hover {
    background: var(--color-paper-2);
  }

  .card-parcelare__loturi .bulina {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
  }

  .card-parcelare__loturi .cod {
    font-family: var(--font-sans);
    color: var(--color-ink);
  }

  .card-parcelare__loturi .sup {
    color: var(--color-ink-3);
  }

  .card-parcelare__loturi .pret {
    font-weight: 600;
    color: var(--color-ink);
    min-width: 4.5rem;
    text-align: right;
  }

  .card-parcelare__loturi [data-stare='vandut'] .pret,
  .card-parcelare__loturi [data-stare='in_pregatire'] .pret {
    font-weight: 400;
    color: var(--color-ink-3);
  }

  .card-parcelare__actiuni {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
  }

  .card-parcelare__actiuni .buton {
    width: 100%;
    font-size: 0.8125rem;
    padding-inline: 0.5rem;
    text-align: center;
  }

  .card-parcelare__lat {
    grid-column: 1 / -1;
  }

  @media (max-width: 767px) {
    .card-parcelare {
      top: auto;
      right: 8px;
      left: 8px;
      bottom: 62px;
      width: auto;
      max-height: 62%;
    }

    /* Cu fișa deschisă, jumătatea de jos a hărții e acoperită. Zoomul și scara
       devin oricum inutilizabile acolo, dar marca Mapbox și atribuirea trebuie
       să rămână vizibile, e obligație de licență, deci urcă deasupra fișei. */
    .ecran-harta[data-fisa] #harta .maplibregl-ctrl-bottom-left,
    .ecran-harta[data-fisa] #harta .maplibregl-ctrl-group {
      display: none;
    }

    .ecran-harta[data-fisa] #harta .maplibregl-ctrl-bottom-right {
      top: 8px;
      bottom: auto;
      left: 8px;
      right: auto;
    }

    .ecran-harta[data-fisa] .marca-mapbox {
      top: 40px;
      bottom: auto;
      left: 10px;
    }
  }

  .maplibregl-ctrl-scale {
    background: rgb(251 250 247 / 0.86);
    border: 1px solid var(--color-hairline);
    border-top: 0;
    border-radius: 0 0 var(--radius-mic) var(--radius-mic);
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    padding: 1px 5px 2px;
  }

  @media (max-width: 767px) {
    /* Pe telefon atribuirea se rupe pe două rânduri și urcă până la 116px de
       jos, deci scara trece deasupra ei. */
    #harta .maplibregl-ctrl-bottom-left {
      left: 8px;
      bottom: 122px;
    }
    .ecran-harta[data-mapbox] #harta .maplibregl-ctrl-bottom-left {
      left: 108px;
    }
    /* Sertarul strâns ocupă vreo 52px jos, iar atribuirea rămânea sub el.
       Nu e o scăpare de aliniere: creditul OpenStreetMap trebuie să se vadă. */
    #harta .maplibregl-ctrl-bottom-right {
      bottom: 62px;
    }
  }

  /* ------------------------------------------------------------------ sertar */
  .sertar {
    position: absolute;
    z-index: 10;
    background: var(--color-paper-3);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-panou);
  }

  .sertar__maner {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .sertar__maner svg {
    transition: transform 180ms ease-out;
  }

  .sertar--deschis .sertar__maner svg {
    transform: rotate(180deg);
  }

  /* Panoul are două etaje: un capitol care se derulează și un subsol care
     rămâne pe loc. Înainte subsolul era în zona derulabilă, deci pe un laptop
     scurt butonul de resetare și linkul spre listă pur și simplu nu existau
     până nu dădeai scroll. */
  .sertar__continut {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .sertar__derulabil {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (min-width: 768px) {
    .sertar {
      top: 16px;
      left: 16px;
      width: var(--sidebar-w);
      max-height: calc(100% - 32px);
      border-radius: var(--radius-panou);
      display: flex;
      flex-direction: column;
    }
    .sertar__maner {
      display: none;
    }
    .sertar__continut {
      flex: 1 1 auto;
    }
    .sertar__derulabil {
      padding: 18px 18px 16px;
    }
  }

  @media (max-width: 767px) {
    .sertar {
      inset: auto 0 0 0;
      border-radius: var(--radius-panou) var(--radius-panou) 0 0;
      border-bottom: 0;
      max-height: 86%;
      display: flex;
      flex-direction: column;
    }
    .sertar__continut {
      display: none;
      flex: 1 1 auto;
    }
    .sertar--deschis .sertar__continut {
      display: flex;
    }
    .sertar__derulabil {
      padding: 4px 16px 16px;
    }
  }

  /* Panoul se poate strânge, ca harta să rămână singură pe ecran. Butonul care
     îl aduce înapoi stă exact unde era colțul lui, ca să se înțeleagă ce face. */
  .sertar__inchide {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 2;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-ink-3);
    padding: 4px 6px;
  }

  .sertar__inchide:hover {
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .sertar__inchide {
      display: none;
    }
  }

  .ecran-harta[data-sertar='inchis'] .sertar {
    display: none;
  }

  .pastila-portofoliu {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px 9px 12px;
    border-radius: var(--radius-panou);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pastila-portofoliu__punct {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-disponibil);
  }

  /* Cu panoul strâns, scara și marca nu mai au de ce să stea împinse. */
  .ecran-harta[data-sertar='inchis'] #harta .maplibregl-ctrl-bottom-left,
  .ecran-harta[data-sertar='inchis'] .marca-mapbox {
    left: 16px;
  }

  .ecran-harta[data-mapbox][data-sertar='inchis'] #harta .maplibregl-ctrl-bottom-left {
    left: 116px;
  }

  /* Capul de panou. Titlul rămâne titlu semantic, dar eroul vizual e cifra
     care se schimbă cu filtrele: aia e răspunsul la ce tocmai ai cerut, iar
     înainte stătea în subsol, sub linia de plutire. */
  .sertar__antet {
    position: relative;
    padding-bottom: 16px;
  }

  .sertar__antet h1 {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .sertar__cifre {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 6px;
  }

  .sertar__nr {
    font-family: var(--font-mono);
    font-size: 2.125rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .sertar__nr-eticheta {
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }

  .sertar__sub {
    margin-top: 8px;
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  .sertar__sub-sep {
    color: var(--color-ink-3);
    margin: 0 2px;
  }

  .sertar__antet[data-gol='da'] .sertar__nr {
    color: var(--color-ink-3);
  }
  /* ------------------------------------------------------------------ câmpuri */
  .camp {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-hairline);
  }

  .camp:first-of-type {
    border-top: 0;
  }

  .camp--linie {
    padding-bottom: 4px;
  }

  .camp > label:not(.comutator),
  .camp legend,
  .camp__cap label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-2);
    margin-bottom: 8px;
  }

  /* Un `legend` se așază implicit PE linia de sus a fieldset-ului și o taie.
     Cât timp „Stare lot” era primul câmp, fără bordură, nu se vedea; „Buget”
     are bordură deasupra, deci linia îi trecea prin cuvânt. Flotarea îl scoate
     din poziția aia specială și-l face titlu obișnuit. */
  .camp legend {
    float: left;
    width: 100%;
  }

  .camp legend + * {
    clear: both;
  }

  .camp__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .camp__cap label {
    margin-bottom: 0;
  }

  .camp__cap output {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
  }

  .camp__nota {
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }

  /* ------------------------------------------------------------- portofoliu */
  .eticheta-portofoliu {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-2);
  }

  .camp__nr {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  .camp--portofoliu .camp__cap {
    margin-bottom: 4px;
  }

  /* Lista are derularea ei: cu 23 de rânduri, dacă ar curge în panou,
     filtrele de suprafață și preț ar ajunge la 1.300 de pixeli mai jos și nu
     le-ar mai găsi nimeni. */
  .portofoliu {
    margin: 0 -18px;
    max-height: min(44vh, 430px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-block: 1px solid var(--color-hairline);
  }

  @media (min-width: 768px) and (max-height: 760px) {
    .portofoliu {
      max-height: 38vh;
    }
  }

  .rand {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 7px 18px;
    text-align: left;
    border-left: 2px solid transparent;
    transition: background 120ms ease-out;
  }

  .rand:hover,
  .rand:focus-visible {
    background: var(--color-paper-2);
    outline: none;
  }

  .rand:focus-visible {
    border-left-color: var(--color-ink);
  }

  .rand[aria-pressed='true'] {
    background: var(--color-paper-2);
    border-left-color: var(--color-ink);
  }

  /* Terenul deschis ultima dată: se însemnează, dar nu arată ca un filtru
     apăsat, pentru că nu filtrează nimic. */
  .rand[data-deschis] {
    border-left-color: var(--color-ink-3);
  }

  .rand[data-deschis] .rand__nume {
    font-weight: 500;
  }

  /* Discul din listă e același semn ca pe hartă, la scară mică: te uiți în
     panou și știi ce cauți pe hartă, fără legendă în plus. */
  .rand__marca {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid var(--c, var(--color-hairline));
    background: var(--color-paper-3);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink);
  }

  .rand__marca--toate {
    border-style: dashed;
    color: var(--color-ink-3);
  }

  .rand__text {
    flex: 1;
    min-width: 0;
  }

  .rand__nume {
    display: block;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .rand__sub {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rand__nr {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
  }

  .rand__stare {
    flex: none;
    font-family: var(--font-mono);
    font-size: 9.5px;
    padding: 2px 5px 3px;
    border-radius: var(--radius-mic);
    background: var(--c);
    color: #fff;
  }

  @media (max-width: 767px) {
    .portofoliu {
      margin: 0 -16px;
      max-height: 42vh;
    }

    .rand {
      padding: 8px 16px;
    }
  }

  .camp select {
    width: 100%;
    padding: 9px 12px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-mic);
    background: var(--color-paper-3);
    font: inherit;
    font-size: 0.9375rem;
  }

  /* ------------------------------------------------------------ legendă-filtru */
  .stari {
    display: flex;
    flex-direction: column;
  }

  .stari label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .stari input {
    accent-color: var(--color-accent);
    width: 15px;
    height: 15px;
  }

  .pastila {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--c) 72%, white);
    border: 1.5px solid var(--b);
    flex: none;
  }

  .stari__text {
    flex: 1;
  }

  .stari__nr {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  .stari input:not(:checked) ~ .stari__text,
  .stari input:not(:checked) ~ .stari__nr {
    color: var(--color-ink-3);
    text-decoration: line-through;
    text-decoration-color: var(--color-hairline);
  }

  /* ------------------------------------------------------------ benzi de buget */
  /* Radio-uri, nu slider: omul are bugetul deja formulat, nu-l descoperă
     trăgând de un capăt. Bulina desenată de noi, ca să fie mai mare decât
     radioul de sistem și să se nimerească pe telefon. */
  .benzi {
    display: flex;
    flex-direction: column;
  }

  .benzi label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    cursor: pointer;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }

  .benzi input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .benzi__bulina {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--color-hairline);
    background: var(--color-paper-3);
    transition: border-color 140ms ease-out;
  }

  .benzi__bulina::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: scale(0);
    transition: transform 140ms ease-out;
  }

  .benzi input:checked ~ .benzi__bulina {
    border-color: var(--color-accent);
  }

  .benzi input:checked ~ .benzi__bulina::after {
    transform: scale(1);
  }

  .benzi input:checked ~ .benzi__text {
    color: var(--color-ink);
    font-weight: 500;
  }

  .benzi input:focus-visible ~ .benzi__bulina {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .benzi__text {
    flex: 1;
  }

  .benzi__nr {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }

  /* Banda fără niciun lot nu se ascunde, se stinge: dispariția ei ar muta
     rândurile sub degetul omului exact când bifează. */
  .benzi li[data-gol='da'] label {
    color: var(--color-ink-3);
    opacity: 0.55;
  }

  .comutator {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .comutator input {
    accent-color: var(--color-accent);
    width: 15px;
    height: 15px;
    flex: none;
    margin: 0;
  }

  .stari input {
    flex: none;
    margin: 0;
  }

  /* ------------------------------------------------- interval cu două capete */
  .interval {
    position: relative;
    height: 26px;
    --start: 0%;
    --end: 100%;
  }

  .interval::before,
  .interval::after {
    content: '';
    position: absolute;
    top: 11px;
    height: 4px;
    border-radius: 2px;
  }

  .interval::before {
    left: 0;
    right: 0;
    background: var(--color-paper-2);
    border: 1px solid var(--color-hairline);
    box-sizing: border-box;
  }

  .interval::after {
    left: var(--start);
    right: calc(100% - var(--end));
    background: var(--color-accent);
  }

  .interval input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
